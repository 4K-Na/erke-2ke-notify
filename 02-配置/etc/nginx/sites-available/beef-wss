# BeEF Secure WebSocket proxy: wss://beef.example.com:61986 → ws://127.0.0.1:61985
server {
    listen 61986 ssl;
    listen [::]:61986 ssl;
    server_name beef.example.com;

    ssl_certificate /etc/letsencrypt/live/beef.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/beef.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:61985;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400;
    }
}
