[Unit]
Description=Guardian device receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/guardian-receiver
Environment=NODE_ENV=production
Environment=PORT=8787
Environment=GUARDIAN_DATA_FILE=/var/lib/guardian-receiver/devices.json
ExecStart=/usr/bin/node /opt/guardian-receiver/server.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
