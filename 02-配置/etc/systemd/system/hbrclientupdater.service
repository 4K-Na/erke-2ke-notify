[Unit]
Description=Alibaba Cloud Backup Update Service
ConditionFileIsExecutable=/opt/alibabacloud/hbrclient/update/updater


[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart=/opt/alibabacloud/hbrclient/update/updater







Restart=always

RestartSec=120
EnvironmentFile=-/etc/sysconfig/hbrclientupdater

[Install]
WantedBy=multi-user.target
