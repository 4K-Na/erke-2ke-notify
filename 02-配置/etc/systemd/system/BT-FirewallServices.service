[Unit]
Description=Firewall and System Event Listener Service
After=network.target

[Service]
ExecStart=/www/server/panel/pyenv/bin/python3 /www/server/panel/script/BT-FirewallServices.py start
ExecReload=/www/server/panel/pyenv/bin/python3 /www/server/panel/script/BT-FirewallServices.py reload
ExecStop=/www/server/panel/pyenv/bin/python3 /www/server/panel/script/BT-FirewallServices.py stop
User=root
Type=simple

[Install]
WantedBy=multi-user.target
