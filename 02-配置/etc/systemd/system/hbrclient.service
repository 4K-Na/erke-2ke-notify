[Unit]
Description=Alibaba Cloud Backup Service
ConditionFileIsExecutable=/opt/alibabacloud/hbrclient/client/hbrclient


[Service]
StartLimitInterval=5
StartLimitBurst=10
ExecStart=/opt/alibabacloud/hbrclient/client/hbrclient "run"







Restart=always

RestartSec=120
EnvironmentFile=-/etc/sysconfig/hbrclient

[Install]
WantedBy=multi-user.target
