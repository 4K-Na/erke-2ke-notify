[Unit]
Description=Personal Growth Archive API
After=network.target redis-personal-growth.service
Wants=redis-personal-growth.service

[Service]
Type=simple
WorkingDirectory=/opt/personal-growth
EnvironmentFile=/etc/personal-growth/app.env
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=30 -Djava.io.tmpdir=/opt/personal-growth/tmp -jar /opt/personal-growth/app.jar
Restart=on-failure
RestartSec=5
User=personalgrowth
Group=personalgrowth
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/personal-growth

[Install]
WantedBy=multi-user.target
