#Version=1.0
[Unit]
Description=Aliyun Assist
ConditionFileIsExecutable=/usr/local/share/aliyun-assist/aliyun-service.symlink
 
After=network-online.target  
Wants=network-online.target 

[Service]
StandardOutput=journal+console
StandardError=journal+console
StartLimitInterval=3600
StartLimitBurst=10
ExecStart=/usr/local/share/aliyun-assist/aliyun-service.symlink







Restart=on-failure

RestartSec=120
EnvironmentFile=-/etc/sysconfig/aliyun
KillMode=process
[Install]
WantedBy=multi-user.target
