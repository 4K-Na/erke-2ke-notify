[Unit]
Description=Tempre Monitor Node Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/www/wwwroot/example.com/tempre-node
ExecStart=/usr/bin/node /www/wwwroot/example.com/tempre-node/server.mjs
Restart=always
RestartSec=3
User=root
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
