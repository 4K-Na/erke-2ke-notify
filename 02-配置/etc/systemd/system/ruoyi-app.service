[Unit]
Description=RuoYi-Vue backend (2ke notification admin)
After=network.target ruoyi-mysql.service ruoyi-redis.service
Wants=ruoyi-mysql.service ruoyi-redis.service

[Service]
Environment="SPRING_REDIS_PASSWORD=<REDIS_PASSWORD>"
ExecStartPre=/bin/bash -c 'for i in $(seq 1 90); do [ -S /run/ruoyi-mysql/mysql.sock ] && /www/server/mysql/bin/mysqladmin --socket=/run/ruoyi-mysql/mysql.sock ping >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
MemoryMax=700M
MemoryHigh=600M
Type=simple
User=root
WorkingDirectory=/opt/ruoyi
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
ExecStart=/usr/lib/jvm/java-17-openjdk-amd64/bin/java \
    -Xms128m -Xmx320m -XX:MaxMetaspaceSize=192m \
    -XX:+UseSerialGC -Xss512k \
    -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai \
    -jar /opt/ruoyi/ruoyi-admin/target/ruoyi-admin.jar \
    --spring.profiles.active=druid \
    --server.address=127.0.0.1 \
    --logging.level.com.ruoyi=info \
    --logging.level.com.ruoyi.system.mapper=warn \
    \
   
Restart=always
RestartSec=15
SuccessExitStatus=143
StandardOutput=append:/var/log/ruoyi.log
StandardError=append:/var/log/ruoyi.log

[Install]
WantedBy=multi-user.target
