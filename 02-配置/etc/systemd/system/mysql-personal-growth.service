[Unit]
Description=MySQL for Personal Growth Archive
After=network.target

[Service]
Type=simple
User=personalgrowth
Group=personalgrowth
RuntimeDirectory=personal-growth-mysql
RuntimeDirectoryMode=0750
ExecStart=/www/server/mysql/bin/mysqld --no-defaults --basedir=/www/server/mysql --datadir=/var/lib/personal-growth-mysql --socket=/run/personal-growth-mysql/mysql.sock --pid-file=/run/personal-growth-mysql/mysql.pid --port=13306 --bind-address=127.0.0.1 --skip-name-resolve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-growth-mysql /run/personal-growth-mysql

[Install]
WantedBy=multi-user.target
