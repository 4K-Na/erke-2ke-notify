[Unit]
Description=Redis for Personal Growth Archive
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/redis-server /etc/personal-growth/redis.conf
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=3
User=personalgrowth
Group=personalgrowth
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-growth-redis

[Install]
WantedBy=multi-user.target
