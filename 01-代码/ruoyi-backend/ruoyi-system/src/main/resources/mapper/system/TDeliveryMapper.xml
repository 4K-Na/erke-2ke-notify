    <select id="selectDeliverySummary" parameterType="TDelivery" resultType="java.util.LinkedHashMap">
        select d.activity_id        as activityId,
               max(d.activity_title) as activityTitle,
               max(a.activity_type)  as activityType,
               max(a.dept_label)     as deptLabel,
               count(*)              as totalCnt,
               sum(case when d.send_status = 'sent'    then 1 else 0 end) as sentCnt,
               sum(case when d.send_status = 'failed'  then 1 else 0 end) as failedCnt,
               sum(case when d.send_status = 'pending' then 1 else 0 end) as pendingCnt,
               max(d.sent_time)      as lastSentTime,
               max(d.create_time)    as lastCreateTime
        from t_delivery d
        left join t_activity a on a.activity_id = d.activity_id
        <where>
            <if test="activityTitle != null and activityTitle != ''"> and d.activity_title like concat('%', #{activityTitle}, '%')</if>
            <if test="subscriberName != null and subscriberName != ''"> and d.subscriber_name like concat('%', #{subscriberName}, '%')</if>
            <if test="channel != null and channel != ''"> and d.channel = #{channel}</if>
            <if test="sendStatus != null and sendStatus != ''"> and d.send_status = #{sendStatus}</if>
            <if test="params.beginCreateTime != null and params.beginCreateTime != ''"> and d.create_time &gt;= #{params.beginCreateTime}</if>
            <if test="params.endCreateTime != null and params.endCreateTime != ''"> and d.create_time &lt;= concat(#{params.endCreateTime}, ' 23:59:59')</if>
        </where>
        group by d.activity_id
        <if test="params.onlyFailed != null and params.onlyFailed != ''"> having sum(case when d.send_status = 'failed' then 1 else 0 end) &gt; 0</if>
        order by failedCnt desc, lastCreateTime desc
    </select>

</mapper>
